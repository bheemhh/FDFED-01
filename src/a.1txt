useEffect




function Profile() {
  const [name, setName] = useState("");

  localStorage.setItem("name", name);

  return (
    <input
      value={name}
      onChange={(e) => setName(e.target.value)}
    />
  );
}



import { useEffect, useState } from "react";

function Profile() {
  const [name, setName] = useState("");

  useEffect(() => {
    localStorage.setItem("name", name);
  },);

  return (
    <input
      value={name}
      onChange={(e) => setName(e.target.value)}
    />
  );
}















