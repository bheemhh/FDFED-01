      height={100}
    />
  );
}

// Child Component
function WelcomeCard(props) {
  return (
    <div className="card">
      <h1>Welcome back, {props.name}!</h1>
      <p>Your current score is: {props.score}</p>
      <Profile   person={{ name: 'Lin Lanying', imageId: '1bX5QH6' }}
      size={100}/> 
     <Profile /> 
      <Profile /> 
    </div>
  
  );
}

